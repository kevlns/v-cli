{
  "schemaVersion": 1,
  "package": "@kevlns/xlmerge",
  "command": "xlmerge",
  "bin": "xlmerge",
  "description": "fixture：Git 中 .xlsx/.xlsm 冲突可视化解决方案（测试用，非真实包）",
  "platforms": ["darwin", "linux", "win32"],
  "runtime": {
    "node": ">=20"
  },
  "environment": [
    {
      "name": "XLMERGE_FIXTURE",
      "description": "fixture 注入的环境变量"
    }
  ],
  "agent": {
    "whenToUse": "fixture xlmerge：当用户需要解决 .xlsx 合并冲突时（测试用）",
    "globalOptions": [
      {
        "flags": "--repo <path>",
        "description": "Git 仓库路径"
      }
    ],
    "commands": [
      {
        "path": ["detect"],
        "usage": "xlmerge --repo <repo> detect",
        "description": "检测未解决的 .xlsx 冲突（fixture）",
        "arguments": [],
        "options": [],
        "output": {
          "format": "json",
          "description": "fixture 输出"
        },
        "exitCodes": {
          "0": "success"
        },
        "safety": ["read-only"]
      },
      {
        "path": ["apply"],
        "usage": "xlmerge --repo <repo> apply",
        "description": "写回决策（fixture）",
        "arguments": [],
        "options": [
          {
            "flags": "--manifest <file>",
            "description": "manifest 文件（fixture）"
          }
        ],
        "output": {
          "format": "json",
          "description": "fixture 输出"
        },
        "exitCodes": {
          "0": "success",
          "1": "error"
        },
        "safety": ["writes-worktree", "commits-by-default"]
      }
    ]
  }
}