{
  "name": "@kevlns/v-cli",
  "version": "0.5.2",
  "description": "提供工具发现、插件路由、工程绑定、结构化能力执行和操作证据管理。",
  "type": "module",
  "bin": {
    "v-cli": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/sdk.d.ts",
  "files": [
    "dist/",
    "schemas/",
    "skills/",
    "AGENTS.md",
    "docs/"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:agents": "node scripts/generate-agents.mjs",
    "check:agents": "node scripts/generate-agents.mjs --check",
    "pack:guard": "node scripts/pack-guard.mjs",
    "test:package": "node scripts/test-package-install.mjs",
    "check": "npm run docs:style && npm run build && npm run typecheck && npm test && npm run docs:check && npm run pack:guard",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:style": "node scripts/check-documentation.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Vant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevlns/v-cli.git"
  },
  "bugs": {
    "url": "https://github.com/kevlns/v-cli/issues"
  },
  "homepage": "https://github.com/kevlns/v-cli#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "toolbox"
  ],
  "dependencies": {
    "@kevlns/art-workshop": "0.4.2",
    "@kevlns/figma-to-uprefab": "0.1.4",
    "@kevlns/ship-cli": "0.1.2",
    "@kevlns/u-cli-mod": "0.3.1",
    "@kevlns/xlmerge": "2.0.4",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
